<!--
  This script corresponds to the "Linked Jobs" page, accessible via a new link
  in the left-hand side menu for labels
-->
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define"
         xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
    
  <l:layout title="${it.title}">
    <st:include it="${it.label}" page="sidepanel.jelly"/>
    <st:adjunct includes="jenkins.plugins.linkedjobs.actions.styles" />
    <l:main-panel>

      <j:set var="groups" value="${it.jobsGroups}" />
      <j:set var="clouds" value="${it.provisioningClouds}" />

      <h2>Label "${it.label}" is
      <j:choose>
        <j:when test="${empty(groups)}">
          not used by jobs
        </j:when>
        <j:otherwise>
          used by the following job(s)
        </j:otherwise>
      </j:choose>
      </h2>

      <div class="llj-dashboard">

        <j:if test="${it.getSize(clouds) > 0}">
            <div>
              Provisioning cloud<j:if test="${it.getSize(clouds) > 1}">s</j:if>:
              <div class="llj__list">
                <j:forEach var="cloud" items="${clouds}">
                  <span>${cloud.displayName}</span>
                </j:forEach>
              </div>
            </div>
        </j:if>

        <j:if test="${!empty(groups)}">
          <div class="llj-card-list">
            <j:forEach var="group" items="${groups}">
              <l:card title="Job${group.hasMoreThanOneJob?'s':''} configured with ${group.label}" expandable="${rootURL}/${group.labelURL}">
                <div class="llj-jobs_list__container llj-jobs_list__container--top">
                <div>
                  <j:choose>
                    <j:when test="${empty(group.nodes)}"><div class="jenkins-alert jenkins-alert-warning">No agents match this label ${group.atom ? '' : ' expression'}</div></j:when>
                    <j:otherwise>
                      <div class="llj__list">
                        <j:forEach var="n" items="${group.nodes}">
                          <j:set var="c" value="${n.toComputer()}" />
                          <j:set var="url" value="${rootURL}/${c.url}"/>
                          <div class="llj__list--agent">
                            <a href="${url}" class="jenkins-link--with-icon"><l:icon src="${c.iconClassName}" /></a>
                            <a href="${url}">${n.displayName}</a>
                          </div>
                        </j:forEach>
                      </div>
                    </j:otherwise>
                  </j:choose>
                </div>

                <j:set var="jobs_clouds" value="${group.provisioningClouds}" />
                <j:if test="${it.getSize(jobs_clouds) > 0}">
                  <div>
                    Provisioning cloud<j:if test="${it.getSize(jobs_clouds) > 1}">s</j:if>:
                    <div class="llj__list">
                      <j:forEach var="job_cloud" items="${jobs_clouds}">
                        <span>${job_cloud.displayName}</span>
                      </j:forEach>
                    </div>
                  </div>
                </j:if>

                <j:if test="${it.detailedView &amp;&amp; !empty(group.jobs)}">
                  <t:projectView jobs="${group.jobs}"/>
                </j:if>
                <j:if test="${!it.detailedView &amp;&amp; !empty(group.jobs)}">
                  <div class="llj__job_list">
                    <j:forEach var="job" items="${group.jobs}">
                      <span><a href="${job.absoluteUrl}">${job.name}</a></span>
                    </j:forEach>
                  </div>
                </j:if>

                <j:if test="${!empty(group.triggeredJobs)}">
                  <div>
                  Triggered jobs (triggering job(s)):
                    <div class="llj__job_list">
                      <j:forEach var="triggeredjob" items="${group.triggeredJobs}">
                        <span class="llj__list--item"><a href="${triggeredjob.triggeredJob.absoluteUrl}">${triggeredjob.triggeredJob.name}</a> (<j:forEach var="triggeringJob" items="${triggeredjob.triggeringJobs}">
                          <a href="${triggeringJob.absoluteUrl}">${triggeringJob.name}</a>
                          </j:forEach>)
                        </span>
                      </j:forEach>
                    </div>
                  </div>
                </j:if>

                <j:if test="${!empty(group.jobsWithLabelDefaultValue)}">
                  <div>
                    Job(s) using this label as default value for a Label parameter:
                    <div class="llj__job_list">
                      <j:forEach var="job" items="${group.jobsWithLabelDefaultValue}">
                        <span><a href="${job.absoluteUrl}">${job.name}</a></span>
                      </j:forEach>
                    </div>
                  </div>
                </j:if>
                </div>
              </l:card>
            </j:forEach>
          </div>
        </j:if>
      </div>
    </l:main-panel>

  </l:layout>    

</j:jelly>