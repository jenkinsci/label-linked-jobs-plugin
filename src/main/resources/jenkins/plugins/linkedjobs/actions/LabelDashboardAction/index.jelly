<!--
  This script corresponds to the "Linked Jobs" page, accessible via a new link
  in the left-hand side menu for labels
-->
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define"
         xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">

  <l:layout title="${it.displayName}">
    <st:include it="${app}" page="sidepanel.jelly"/>
    <st:adjunct includes="jenkins.plugins.linkedjobs.actions.LabelDashboardAction.styles" />

    <l:main-panel>
      <div class="llj-dashboard">
        <div>
          <h2>Labels</h2>
          <j:set var="unused" value="${it.refresh}" />
          <j:set var="hasClouds" value="${it.hasAtLeastOneCloud}" />
          <j:set var="labels" value="${it.labelsData}" />
          <t:setIconSize/>
          <table class="llj-table sortable jenkins-table ${iconSize == '16x16' ? 'jenkins-table--small' : iconSize == '24x24' ? 'jenkins-table--medium' : ''}">
            <thead>
              <tr>
                <th>Label</th>
                <th class="right"># of Jobs</th>
                <th class="right" tooltip="The number of jobs that are triggered by other jobs using the Label with a Node/Label Parameter"># of Triggered Job Configurations</th>
                <th class="right" tooltip="The number of jobs that have the label as default value for their Node/Label Parameter"># of Default Label Job Configurations</th>
                <th class="right" tooltip="The number of agents with the label"># of Agents</th>
                <j:if test="${hasClouds}">
                  <th class="right" tooltip="The number of clouds that can provision agents for the label"># of Clouds</th>
                </j:if>
              </tr>
            </thead>
            <j:forEach var="label" items="${labels}">
              <j:set var="jobCount" value="${label.jobsCount}" />
              <j:set var="nodeCount" value="${label.nodesCount}" />
              <j:set var="cloudCount" value="${label.cloudsCount}" />
              <j:set var="pluginActive" value="${label.pluginActiveForLabel}" />
              <j:set var="triggeredJobCount" value="${label.triggeredJobsCount}" />
              <j:set var="jobsWithLabelDefaultValueCount" value="${label.jobsWithLabelDefaultValueCount}" />
              <tr>
                <td class="label"><a class="jenkins-table__link model-link inside" href="${rootURL}/${label.labelURL}">${label.label}</a>
                  <j:if test="${(jobCount + triggeredJobCount + jobsWithLabelDefaultValueCount) == 0}"><l:icon src="symbol-warning-outline plugin-ionicons-api" class="jenkins-!-warning-color icon-sm" tooltip="Label is not used anywhere. You should verify your configuration."/></j:if>
                  <j:if test="${(nodeCount == 0) &amp;&amp; ((!hasClouds) || (cloudCount == 0))}"><l:icon src="symbol-alert-circle-outline plugin-ionicons-api" class="jenkins-!-error-color icon-sm " tooltip="Label not served by any agent or cloud. You should verify your configuration."/></j:if>
                </td>
                <td class="right">
                  <j:if test="${pluginActive}"><a class="jenkins-table__link" href="${rootURL}/${label.labelURL}linkedjobs">${jobCount}</a>
                  </j:if>
                  <j:if test="${!pluginActive}"><a class="jenkins-table__link" href="${rootURL}/${label.labelURL}configure" tooltip="Activate Linked Jobs page to know more">${jobCount}</a>
                  </j:if>
                </td>
                <td class="right">${triggeredJobCount}</td>
                <td class="right">${jobsWithLabelDefaultValueCount}</td>
                <td class="right">${nodeCount}</td>
                <j:if test="${hasClouds}">
                  <td class="right">${cloudCount}</td>
                </j:if>
              </tr>
            </j:forEach>
          </table>
        </div>

        <div>
          <h2>Agents</h2>
          <j:set var="allExclusive" value="${it.onlyExclusiveNodes}" />
          <j:if test="${allExclusive}">
            <div class="jenkins-alert jenkins-alert-info">Note: all agents are in exclusive mode.</div>
          </j:if>
          <j:set var="nodes" value="${it.nodesData}" />
          <table class="llj-table sortable jenkins-table ${iconSize == '16x16' ? 'jenkins-table--small' : iconSize == '24x24' ? 'jenkins-table--medium' : ''}">
            <thead>
              <tr>
                <th>Name</th>
                <th class="right"># of Jobs</th>
                <th class="right" tooltip="The number of jobs that are triggered by other jobs using the agent name with a Node/Label Parameter"># of Triggered Job Configurations</th>
                <th class="right" tooltip="The number of jobs that have the agent name as default value for their Node/Label Parameter"># of Default Label Job Configurations</th>
              </tr>
            </thead>
            <j:forEach var="node" items="${nodes}">
              <tr>
                <j:set var="jobCount" value="${node.jobsCount}" />
                <j:set var="triggeredJobCount" value="${node.triggeredJobsCount}" />
                <j:set var="jobsWithLabelDefaultValueCount" value="${node.jobsWithLabelDefaultValueCount}" />
                <td><a class="jenkins-table__link model-link inside" href="${rootURL}/${node.nodeURL}">${node.name}</a></td>
                <td class="right">${jobCount}</td>
                <td class="right">${triggeredJobCount}</td>
                <td class="right">${jobsWithLabelDefaultValueCount}</td>
              </tr>
            </j:forEach>
          </table>
        </div>

        <div>
          <j:set var="orphanedJobs" value="${it.orphanedJobs}" />
          <j:set var="orphanedTriggeredJobs" value="${it.orphanedTriggeredJobs}" />
          <j:set var="orphanedDefaultValueJobs" value="${it.orphanedDefaultValueJobs}" />
          <h2>Orphaned Jobs</h2>
          <j:choose>
            <j:when test="${empty(orphanedJobs) &amp;&amp; empty(orphanedTriggeredJobs) &amp;&amp; empty(orphanedDefaultValueJobs)}">
              <div class="jenkins-alert jenkins-alert-success">There are no orphaned jobs. Well done with your configuration!</div>
            </j:when>
            <j:otherwise>

              <j:if test="${!empty(orphanedJobs)}">
                <div class="jenkins-alert jenkins-alert-warning">The following job(s) cannot run on any agent because of label (mis-)configuration. Get to it!</div>
                <j:if test="${it.dashboardOrphanedJobsDetailedView}">
                  <t:projectView jobs="${orphanedJobs}"/>
                </j:if>
                <j:if test="${!it.dashboardOrphanedJobsDetailedView}">
                  <div class="llj__job_list">
                    <j:forEach var="job" items="${orphanedJobs}">
                      <span><a href="${job.absoluteUrl}">${job.name}</a></span>
                    </j:forEach>
                  </div>
                </j:if>
              </j:if>

              <div class="llj-jobs_list__container">
                <j:if test="${!empty(orphanedTriggeredJobs)}">
                  <div>Orphaned triggered jobs (triggering job(s)):
                    <div class="llj__job_list">
                      <j:forEach var="triggeredjob" items="${orphanedTriggeredJobs}" varStatus="outerLoopStatus">
                        <span class="llj__job_list--item">
                          <a href="${triggeredjob.triggeredJob.absoluteUrl}">${triggeredjob.triggeredJob.name}</a> (<j:forEach var="triggeringJob" items="${triggeredjob.triggeringJobs}" varStatus="innerLoopStatus">
                          <a href="${triggeringJob.absoluteUrl}">${triggeringJob.name}</a>
                          </j:forEach>)
                        </span>
                      </j:forEach>
                    </div>
                  </div>
                </j:if>

                <j:if test="${!empty(orphanedDefaultValueJobs)}">
                  <div>
                  Orphaned jobs, considering their default Label parameter value:
                    <div class="llj__job_list">
                      <j:forEach var="job" items="${orphanedDefaultValueJobs}">
                        <a href="${job.absoluteUrl}">${job.name}</a>
                      </j:forEach>
                    </div>
                  </div>
                </j:if>
              </div>
            </j:otherwise>
          </j:choose>
        </div>

        <j:if test="${it.showSingleNodeJobs}">
          <div>
            <j:set var="singleNodeJobsByNode" value="${it.singleNodeJobs}" />
            <h2>Single-agent Jobs</h2>
            <j:choose>
              <j:when test="${empty(singleNodeJobsByNode)}">
                <div class="jenkins-alert jenkins-alert-success">There are no single-agent jobs. Well done with your configuration!</div>
              </j:when>
              <j:otherwise>
                <div class="jenkins-alert jenkins-alert-warning">The following job(s) can run on only one agent because of label (mis-)configuration, so you may have trouble if their dedicated agent goes down.</div>
                <div class="llj-single-node-jobs">
                  <j:forEach var="node" items="${singleNodeJobsByNode}">
                    <l:card title="${node.name}" expandable="${rootURL}/${node.nodeURL}">
                      <j:if test="${it.dashboardOrphanedJobsDetailedView}">
                        <t:projectView jobs="${node.jobs}"/>
                      </j:if>
                      <j:if test="${!it.dashboardOrphanedJobsDetailedView}">
                        <div class="llj__job_list">
                          <j:forEach var="job" items="${node.jobs}" varStatus="loopStatus">
                            <a href="${job.absoluteUrl}">${job.name}</a>
                          </j:forEach>
                        </div>
                      </j:if>

                      <div class="llj-jobs_list__container">
                        <j:set var="triggeredJobs" value="${node.triggeredJobs}" />
                        <j:if test="${!empty(triggeredJobs)}">
                          <div>
                            Triggered jobs (triggering job(s)):
                            <div class="llj__job_list">
                              <j:forEach var="triggeredjob" items="${triggeredJobs}">
                                <span class="llj__job_list--item">
                                <a href="${triggeredjob.triggeredJob.absoluteUrl}">${triggeredjob.triggeredJob.name}</a> (<j:forEach var="triggeringJob" items="${triggeredjob.triggeringJobs}">
                                    <a href="${triggeringJob.absoluteUrl}">${triggeringJob.name}</a>
                                  </j:forEach>)
                                </span>
                              </j:forEach>
                            </div>
                          </div>
                        </j:if>

                        <j:set var="jobsWithLabelDefaultValue" value="${node.jobsWithLabelDefaultValue}" />
                        <j:if test="${!empty(jobsWithLabelDefaultValue)}">
                          <div>By default value:
                            <div class="llj__job_list">
                              <j:forEach var="job" items="${jobsWithLabelDefaultValue}">
                                <a href="${job.absoluteUrl}">${job.name}</a>
                              </j:forEach>
                            </div>
                          </div>
                        </j:if>
                      </div>
                    </l:card>
                  </j:forEach>
                </div>
              </j:otherwise>
            </j:choose>
          </div>
        </j:if>

        <j:if test="${it.showLabellessJobs}">
          <div>
            <j:set var="labellessJobs" value="${it.jobsWithNoLabels}" />
            <h2>Label-less jobs</h2>
            <j:choose>
              <j:when test="${empty(labellessJobs)}">
                <div class="jenkins-alert jenkins-alert-success">There are no jobs with no defined label.</div>
              </j:when>
              <j:otherwise>
                <div class="jenkins-alert jenkins-alert-warning">The following job(s) have no assigned labels.</div>
                <j:if test="${it.dashboardOrphanedJobsDetailedView}">
                  <t:projectView jobs="${labellessJobs}"/>
                </j:if>
                <j:if test="${!it.dashboardOrphanedJobsDetailedView}">
                  <div class="llj__job_list">
                    <j:forEach var="job" items="${labellessJobs}">
                      <a href="${job.absoluteUrl}" class="model-link">${job.name}</a>
                    </j:forEach>
                  </div>
                </j:if>
              </j:otherwise>
            </j:choose>
          </div>
        </j:if>
      </div>
    </l:main-panel>
  </l:layout>
</j:jelly>